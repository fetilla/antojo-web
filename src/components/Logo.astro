---
import mascota from '../assets/brand/antojo-ajo.svg?raw';

interface Props {
  size?: 'sm' | 'lg';
}

const { size = 'sm' } = Astro.props;
const svg = mascota.replace('role="img" aria-label="Antojo"', 'aria-hidden="true" focusable="false"');
---

<span class:list={['logo', `logo--${size}`]}>
  <span class="logo__mark" set:html={svg} />
  <span class="logo__word">Antojo</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--crema);
  }
  .logo__mark {
    display: inline-flex;
    width: 32px;
    height: 32px;
    padding: 2px;
    border-radius: 9999px;
    background: var(--crema);
    color: var(--burdeos);
    overflow: hidden;
  }
  .logo__mark :global(svg) {
    width: 100%;
    height: 100%;
    transform: translate(2px, 2px) scale(1.12);
  }
  .logo__word {
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .logo--lg .logo__mark {
    width: 64px;
    height: 64px;
    padding: 4px;
  }
  .logo--lg .logo__word {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }
</style>
