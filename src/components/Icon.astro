---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const svg = icons[name].replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---

<span class:list={['icon', className]} set:html={svg} />

<style>
  .icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.25em;
    height: 1.25em;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
