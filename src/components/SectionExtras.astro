---
// Contenido interactivo que se inserta dentro de los textos del recorrido
// (el motor solo pinta título, cuerpo y botones). main.ts mueve cada
// <template data-extra="id"> a su sección.
import Icon from './Icon.astro';
import { cocina, etiquetas } from '../data/content';
---

<template data-extra="nosotros">
  <ul class="chips" role="list">
    {
      etiquetas.simples.map((t) => (
        <li class="chip">
          <Icon name={t.icon} />
          {t.label}
        </li>
      ))
    }
    <li class="chip-group">
      <button
        class="chip chip--toggle"
        type="button"
        aria-expanded="false"
        aria-controls="eventos-opciones"
        data-eventos
      >
        <Icon name="confetti" />
        {etiquetas.eventos.label}
        <Icon name="caret" class="chip__caret" />
      </button>
      <div class="chip-sub" id="eventos-opciones" data-eventos-sub>
        <ul class="chip-sub__list" role="list">
          {
            etiquetas.eventos.opciones.map((o) => (
              <li class="chip chip--sub">
                <Icon name={o.icon} />
                {o.label}
              </li>
            ))
          }
        </ul>
      </div>
    </li>
  </ul>
</template>

<template data-extra="carta">
  <div class="extra-actions">
    <a class="btn btn--primary" href="#carta" data-open-carta>
      <Icon name="book" />
      Ver la carta
    </a>
  </div>
</template>

<template data-extra="cocina">
  <ul class="chips chips--kitchen" role="list">
    {
      cocina.map((c) => (
        <li class="chip">
          <Icon name={c.icon} />
          {c.label}
        </li>
      ))
    }
  </ul>
</template>

<style is:global>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    pointer-events: auto;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    color: var(--crema);
    background: color-mix(in srgb, var(--sw-accent) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--sw-accent) 55%, transparent);
  }

  .chip .icon {
    color: var(--sw-accent);
  }

  .chip-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chip--toggle {
    font-family: var(--font);
    cursor: pointer;
    transition:
      background-color 700ms var(--ease),
      transform 700ms var(--ease);
  }

  .chip--toggle:hover {
    background: color-mix(in srgb, var(--sw-accent) 32%, transparent);
  }

  .chip--toggle:active {
    transform: scale(0.98);
  }

  .chip--toggle .chip__caret {
    transition: transform 700ms var(--ease);
  }

  .chip--toggle[aria-expanded='true'] .chip__caret {
    transform: rotate(180deg);
  }

  .chip-sub {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 700ms var(--ease);
  }

  .chip-sub.is-open {
    grid-template-rows: 1fr;
  }

  .chip-sub__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0 0 0 16px;
    list-style: none;
  }

  .chip--sub {
    background: var(--gualda);
    color: var(--tinta);
    border-color: var(--gualda);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 700ms var(--ease),
      transform 700ms var(--ease);
  }

  .chip--sub .icon {
    color: var(--tinta);
  }

  .chip-sub.is-open .chip--sub {
    opacity: 1;
    transform: none;
  }

  .chip-sub.is-open .chip--sub:nth-child(2) {
    transition-delay: 100ms;
  }

  .extra-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
    pointer-events: auto;
  }
</style>
