---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import { contacto } from '../data/content';
---

<Layout title="Página no encontrada · Antojo" description="Esta página no existe." noindex>
  <main id="contenido" class="notfound">
    <Logo size="lg" />
    <h1>Esta página no está en la carta</h1>
    <p>Puede que el enlace haya cambiado. Vuelve al inicio o escríbenos y te ayudamos.</p>
    <div class="notfound__actions">
      <a class="btn btn--primary" href={url('/')}>Volver al inicio</a>
      <a class="btn btn--ghost" href={contacto.whatsappHref} target="_blank" rel="noopener">
        Escríbenos por WhatsApp
      </a>
    </div>
  </main>
</Layout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 100dvh;
    padding: 48px 16px;
    box-sizing: border-box;
    text-align: center;
  }
  h1 {
    max-width: 680px;
    margin: 16px 0 0;
    font-size: 3rem;
    line-height: 1;
  }
  p {
    max-width: 680px;
    margin: 0;
    color: var(--crema-soft);
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }
</style>
