---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import CartaDialog from '../components/CartaDialog.astro';
import MediaDialog from '../components/MediaDialog.astro';
import Cards from '../components/Cards.astro';
import Tagline from '../components/Tagline.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout preloadPoster>
  <Header />
  <main id="contenido" tabindex="-1">
    <section class="wt" id="world" aria-label="Recorrido por Antojo">
      <div class="wt__stage" data-stage>
        <picture>
          <source media="(max-width: 860px)" srcset={url('/posters/s0-entrada-m.jpg')} />
          <img class="wt__poster" src={url('/posters/s0-entrada.jpg')} alt="" fetchpriority="high" data-poster />
        </picture>
      </div>
      <div class="wt__progress" aria-hidden="true"><span data-progress></span></div>
      <p class="wt__hint" aria-hidden="true" data-hint>Desliza para entrar</p>
      <div class="wt__cards">
        <Cards />
      </div>
      <div class="wt__track" data-track></div>
    </section>
    <Tagline />
    <Contact />
  </main>
  <Footer />
  <WhatsAppFab />
  <CartaDialog />
  <MediaDialog />
</Layout>

<noscript>
  <style>
    .wt__track { display: none; }
    .wt__cards { position: static !important; }
    .wt-card { position: static !important; opacity: 1 !important; visibility: visible !important; translate: none !important; width: auto !important; margin: 16px; }
  </style>
</noscript>

<script>
  import '../scripts/main';
</script>

<style is:global>
  /* ---- Recorrido (walkthrough.ts) ---- */
  .wt {
    position: relative;
  }

  .wt__stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--burdeos-900);
  }

  .wt__poster,
  .wt__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wt__media {
    z-index: 1;
  }

  .wt__poster {
    z-index: 2;
    transition: opacity 300ms ease;
  }

  .wt__poster.is-hidden {
    opacity: 0;
  }

  .wt__progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 4px;
    background: color-mix(in srgb, var(--gualda) 14%, transparent);
  }

  .wt__progress span {
    display: block;
    height: 100%;
    background: var(--gualda);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  .wt__hint {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 20;
    margin: 0;
    translate: -50% 0;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--crema);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
    pointer-events: none;
  }

  .wt__cards {
    position: fixed;
    inset: 0;
    z-index: 20;
    pointer-events: none;
  }

  .wt__track {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  /* fuera del recorrido se ocultan la pista y la barra */
  .wt.is-past .wt__hint,
  .wt.is-past .wt__progress {
    opacity: 0;
  }

  /* Móvil: el recorrido cubre toda la pantalla, también bajo la barra de direcciones */
  @media (max-width: 860px) {
    .wt__stage {
      bottom: auto;
      height: 100lvh;
    }
    .wt__hint {
      bottom: auto;
      top: calc(96px + env(safe-area-inset-top));
    }
  }
</style>
